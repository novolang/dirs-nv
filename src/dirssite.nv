// dirssite.nv — the directories the system provides, and the order a
// file is looked for in.
//
// THE LIST IS THE POINT, NOT THE DIRECTORY
//
// `$XDG_CONFIG_DIRS` and `$XDG_DATA_DIRS` are not a directory each.
// They are ordered, colon-separated lists, and the specification's
// rule is that a file is looked for in the user's own directory first
// and then in each list entry in turn, the first match winning.  A
// program that read only the first entry would ignore a package's
// defaults; a program that read them in the wrong order would let a
// system default override a user's own file.
//
// `search_path` is that rule as one call, and it is the function to
// use.  The two list functions below are for a program that has to
// show a user where it looked.
//
// WHAT A WINDOWS AND A MACOS SYSTEM DIRECTORY IS
//
// macOS has `/Library/Application Support` and `/Library/Caches`, the
// system-wide counterparts of the per-user ones.  Windows has
// `%ProgramData%`.  Neither platform has a LIST: there is exactly one
// system directory of each kind, so `site_config` and `site_data`
// answer one entry there and several on an XDG system.

use std.list
use std.str
use dirsbase
use dirsenv
use dirskind

// A directory list split into its entries, with the empty ones
// dropped: a path of nothing is not a directory.
fn split_list(value: Str, sep: Str) -> [Str] []
    var out: [Str] = []
    for entry in str.split(value, sep)
        if entry != ""
            list.push(out, entry)
    out

// One entry from a directory the environment named, or an empty list
// when it named none.  A system directory nobody told this package
// about is not one it will invent.
fn one_entry(path: Str) -> [Str] []
    if path == ""
        []
    else
        [path]

// The XDG configuration list: the variable split on this platform's
// list separator, or the specification's single default.
fn xdg_config(e: dirsenv.DirsEnv) -> [Str] []
    let set = dirsenv.var_of(e, "XDG_CONFIG_DIRS")
    if set == ""
        ["/etc/xdg"]
    else
        split_list(set, ":")

// The XDG data list, whose default is two entries in the order that
// finds a locally installed package's files before the distribution's.
fn xdg_data(e: dirsenv.DirsEnv) -> [Str] []
    let set = dirsenv.var_of(e, "XDG_DATA_DIRS")
    if set == ""
        ["/usr/local/share", "/usr/share"]
    else
        split_list(set, ":")

// A relative path laid under a directory, with `/` written as the
// platform's separator.  The join is a function rather than an
// expression at each call site because a `+` written inside a match arm
// is leaked by the 0.20.2 compiler whether or not the arm runs — a
// shape `novo.lint` does not see and `novo test` reports as `the run
// leaked`, exit 23.  The filing is
// `language/a-join-in-a-match-arm-is-leaked-even-when-the-arm-is-not-taken`.
// An empty relative path adds nothing, so the answer is the directory
// itself rather than a trailing separator.
fn under(base: Str, relative: Str, sep: Str) -> Str []
    if relative == ""
        base
    else
        base + sep + str.replace(relative, "/", sep)

// The system-wide directories of a kind, or none for the kinds the
// specification gives no list to.  A caller can ask for every kind
// without first asking which ones have a list.
fn site_dirs(e: dirsenv.DirsEnv, k: dirskind.DirsKind) -> [Str] []
    if k == DirsConfig
        site_config(e)
    elif k == DirsData
        site_data(e)
    else
        []

// The system-wide configuration directories, in the order they are
// searched.
//
// `$XDG_CONFIG_DIRS` split on `:`, defaulting to the single entry
// `/etc/xdg`.  One entry on macOS and Windows.  An empty entry in the
// variable is dropped, because a path of nothing is not a directory.
//
// ```novo
// use dirsenv
// use dirssite
//
// fn main() [io]
//     println("${list.len(dirssite.site_config(dirsenv.of(DirsXdg, "/home/ada")))}")
// ```
pub fn site_config(e: dirsenv.DirsEnv) -> [Str] []
    if e.platform == DirsXdg
        xdg_config(e)
    elif e.platform == DirsMacos
        ["/Library/Application Support"]
    else
        one_entry(e.program_data)

// The system-wide data directories, in the order they are searched.
//
// `$XDG_DATA_DIRS` split on `:`, defaulting to `/usr/local/share` and
// then `/usr/share` — in that order, so a locally installed package's
// files are found before the distribution's.
//
// ```novo
// use dirsenv
// use dirssite
//
// fn main() [io]
//     println("${list.len(dirssite.site_data(dirsenv.of(DirsXdg, "/home/ada")))}")
// ```
pub fn site_data(e: dirsenv.DirsEnv) -> [Str] []
    if e.platform == DirsXdg
        xdg_data(e)
    elif e.platform == DirsMacos
        ["/Library/Application Support"]
    else
        one_entry(e.program_data)

// Every directory a file of this kind is looked for in, in order.
//
// The user's own directory first, then each system-wide entry.  That
// order is the specification's, and it is what lets a user's file
// override a package's default.
//
// A kind with no system-wide counterpart — cache, state, runtime,
// executable — answers just the user's directory, so a caller can use
// this function for every kind without asking which ones have lists.
//
// ```novo
// use dirsenv
// use dirssite
//
// fn main() [io]
//     let e = dirsenv.of(DirsXdg, "/home/ada")
//     println("${list.len(dirssite.search_path(e, DirsConfig))}")
// ```
pub fn search_path(e: dirsenv.DirsEnv, k: dirskind.DirsKind) -> [Str] []
    var out: [Str] = []
    if let Some(mine) = dirsbase.base(e, k)
        list.push(out, mine)
    for entry in site_dirs(e, k)
        list.push(out, entry)
    out

// Every place a named file would be looked for, in order.
//
// `search_path` with the relative path appended to each entry.  The
// list a program hands to its own "open the first of these that
// exists" loop, and the list it prints when none of them did.
//
// ```novo
// use dirsenv
// use dirssite
//
// fn main() [io]
//     let e = dirsenv.of(DirsXdg, "/home/ada")
//     println("${list.len(dirssite.candidates(e, DirsConfig, "novo/config.toml"))}")
// ```
pub fn candidates(e: dirsenv.DirsEnv, k: dirskind.DirsKind, relative: Str) -> [Str] []
    var out: [Str] = []
    let sep = dirskind.separator_of(e.platform)
    for entry in search_path(e, k)
        list.push(out, under(entry, relative, sep))
    out

// Whether a kind has system-wide directories at all.
//
// True for configuration and data, false for the other six.  The
// specification gives a list to those two and to no others, and a
// program that looked for a system-wide cache would be looking for
// something that is not defined to exist.
//
// ```novo
// use dirskind
// use dirssite
//
// fn main() [io]
//     println("${dirssite.has_site_dirs(DirsConfig)}")
//     println("${dirssite.has_site_dirs(DirsCache)}")
// ```
pub fn has_site_dirs(k: dirskind.DirsKind) -> Bool []
    k == DirsConfig or k == DirsData

// The character a platform separates its directory lists with: `":"`
// on XDG and macOS, `";"` on Windows.
//
// Windows separates a list with a semicolon because a colon is part of
// a drive letter, and a program that split on a colon there would
// split `C:\ProgramData` into two entries.
//
// ```novo
// use dirskind
// use dirssite
//
// fn main() [io]
//     println(dirssite.list_separator_of(DirsWindows))
// ```
pub fn list_separator_of(p: dirskind.DirsPlatform) -> Str []
    match p
        DirsWindows => ";"
        _           => ":"
